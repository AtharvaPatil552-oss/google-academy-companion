# Frontend environment template — copy to frontend/.env and fill in.
# These are PUBLIC Firebase client config values (safe to ship in the
# browser bundle). NEVER put backend secrets (GEMINI_API_KEY) here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
