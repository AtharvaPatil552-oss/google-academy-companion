rules_version = '2';

// SECURITY ARCHITECTURE (docs/security-architecture.md §4)
// --------------------------------------------------------
// All Firestore access is server-side through the FastAPI backend
// (Firebase Admin SDK), which enforces per-user scoping in code.
// Web/mobile clients NEVER access Firestore directly, so the entire
// ruleset denies all client access. Anything other than deny-all
// here is a security bug.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
